        "# Instalar bibliotecas (se ainda não tiver)\n",
        "!pip install mediapipe opencv-python\n",
        "\n",
        "# Imports\n",
        "import cv2\n",
        "import mediapipe as mp\n",
        "import numpy as np\n",
        "import pickle\n",
        "from google.colab.patches import cv2_imshow\n",
        "from google.colab import files\n",
        "\n",
        "# Upload do modelo\n",
        "uploaded = files.upload()  # Selecione o arquivo eye_state_model.pkl\n",
        "\n",
        "# Carregar o modelo\n",
        "with open(\"eye_state_model.pkl\", \"rb\") as f:\n",
        "    model = pickle.load(f)\n",
        "\n",
        "# Função para calcular EAR (eye aspect ratio)\n",
        "def eye_aspect_ratio(landmarks, eye_indices, w, h):\n",
        "    eye = np.array([(int(landmarks[i].x * w), int(landmarks[i].y * h)) for i in eye_indices])\n",
        "    A = np.linalg.norm(eye[1] - eye[5])\n",
        "    B = np.linalg.norm(eye[2] - eye[4])\n",
        "    C = np.linalg.norm(eye[0] - eye[3])\n",
        "    ear = (A + B) / (2.0 * C)\n",
        "    return ear\n",
        "\n",
        "# Índices dos olhos no MediaPipe\n",
        "LEFT_EYE = [362, 385, 387, 263, 373, 380]\n",
        "RIGHT_EYE = [33, 160, 158, 133, 153, 144]\n",
        "\n",
        "# Upload da imagem para testar\n",
        "uploaded = files.upload()  # Selecione uma imagem com rosto\n",
        "\n",
        "# Pega nome do arquivo enviado\n",
        "file_name = list(uploaded.keys())[0]\n",
        "image = cv2.imread(file_name)\n",
        "\n",
        "# Detectar rosto e olhos com MediaPipe\n",
        "mp_face_mesh = mp.solutions.face_mesh\n",
        "with mp_face_mesh.FaceMesh(static_image_mode=True) as face_mesh:\n",
        "    h, w, _ = image.shape\n",
        "    rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
        "    result = face_mesh.process(rgb)\n",
        "\n",
        "    if result.multi_face_landmarks:\n",
        "        for face_landmarks in result.multi_face_landmarks:\n",
        "            left_ear = eye_aspect_ratio(face_landmarks.landmark, LEFT_EYE, w, h)\n",
        "            right_ear = eye_aspect_ratio(face_landmarks.landmark, RIGHT_EYE, w, h)\n",
        "            avg_ear = (left_ear + right_ear) / 2\n",
        "\n",
        "            print(\"AVG EAR:\", avg_ear)\n",
        "\n",
        "\n",
        "            # Classificar com o modelo treinado\n",
        "            prediction = model.predict([[avg_ear]])[0]\n",
        "            threshold = 0.25  # pode ajustar se quiser\n",
        "            status = \"Olhos FECHADOS\" if avg_ear < threshold else \"Olhos ABERTOS\"\n",
        "            color = (0, 255, 0) if prediction > 0.26 else (0, 0, 255)\n",
        "\n",
        "            # Mostrar na imagem\n",
        "            cv2.putText(image, status, (30, 60), cv2.FONT_HERSHEY_SIMPLEX, 1.5, color, 3)\n",
        "            cv2_imshow(image)\n",
        "    else:\n",
        "        print(\"Nenhum rosto detectado 😢\")\n",
        "\n"
